{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vectoplan.local/contracts/structural-report-template.schema.json",
  "title": "VECTOPLAN Structural HTML Report Template",
  "type": "object",
  "required": [
    "contract_version",
    "template_id",
    "discipline",
    "family",
    "title",
    "chapters",
    "outline_profile",
    "outline_variants",
    "position_groups",
    "calculation_modules",
    "default_outline_statistics",
    "variable_slots",
    "pipeline_binding",
    "visualization_plan",
    "preview",
    "rendering"
  ],
  "properties": {
    "contract_version": {"const": "structural-report-template/0.2"},
    "template_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]+$"},
    "discipline": {"enum": ["hochbau", "tiefbau", "ingenieurbau", "sonderbau"]},
    "family": {"type": "string", "minLength": 2},
    "title": {"type": "string", "minLength": 2},
    "short_title": {"type": "string"},
    "summary": {"type": "string"},
    "tags": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "system_figure": {
      "enum": ["building", "hall", "bridge", "tunnel", "foundation", "retaining", "water", "tower", "special"]
    },
    "accent": {"type": "string", "pattern": "^#[0-9a-fA-F]{6}$"},
    "chapters": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "required": ["chapter_id", "number", "title", "kind", "source"],
        "properties": {
          "chapter_id": {"type": "string"},
          "number": {"type": "string"},
          "title": {"type": "string"},
          "kind": {"enum": ["frontmatter", "narrative", "calculation", "matrix", "appendix"]},
          "source": {"enum": ["template", "project", "pipeline", "hybrid"]},
          "repeatable": {"type": "boolean"},
          "module_id": {"type": "string"},
          "group": {"type": "string"},
          "group_title": {"type": "string"},
          "section_template_id": {"type": "string"},
          "repeat_by": {"type": "string"},
          "calculations": {"type": "array", "items": {"type": "string"}},
          "outputs": {"type": "array", "items": {"type": "string"}},
          "page_range": {
            "type": "array",
            "prefixItems": [{"type": "integer"}, {"type": "integer"}],
            "minItems": 2,
            "maxItems": 2
          }
        }
      }
    },
    "outline_profile": {
      "type": "object",
      "required": ["profile_id", "base_profile_id", "groups"]
    },
    "outline_variants": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["variant_id", "label", "description"]
      }
    },
    "position_groups": {"type": "array", "items": {"type": "string"}},
    "calculation_modules": {"type": "array", "items": {"type": "object"}},
    "default_outline_statistics": {"type": "object"},
    "variable_slots": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": ["slot_id", "label", "json_pointer", "value_type", "source", "target"],
        "properties": {
          "slot_id": {"type": "string"},
          "label": {"type": "string"},
          "json_pointer": {"type": "string", "pattern": "^/"},
          "value_type": {"enum": ["string", "number", "date", "status", "list", "object"]},
          "unit": {"type": "string"},
          "source": {"enum": ["project", "model", "pipeline", "manual", "registry"]},
          "target": {"type": "string"},
          "required": {"type": "boolean"}
        }
      }
    },
    "pipeline_binding": {
      "type": "object",
      "required": ["profile_id", "stages"],
      "properties": {
        "profile_id": {"type": "string"},
        "label": {"type": "string"},
        "stages": {
          "type": "array",
          "minItems": 5,
          "items": {
            "type": "object",
            "required": ["stage_id", "label", "source_path", "targets"],
            "properties": {
              "stage_id": {"type": "string"},
              "label": {"type": "string"},
              "source_path": {"type": "string"},
              "targets": {"type": "array", "items": {"type": "string"}}
            }
          }
        }
      }
    },
    "preview": {
      "type": "object",
      "required": ["project_name", "position_ref", "position_title", "sample_values", "check"],
      "properties": {
        "project_name": {"type": "string"},
        "position_ref": {"type": "string"},
        "position_title": {"type": "string"},
        "sample_values": {"type": "object"},
        "check": {
          "type": "object",
          "required": ["label", "demand", "resistance", "utilization"],
          "properties": {
            "label": {"type": "string"},
            "demand": {"type": "string"},
            "resistance": {"type": "string"},
            "utilization": {"type": "number", "minimum": 0}
          }
        }
      }
    },
    "rendering": {
      "type": "object",
      "required": ["format", "pages", "binding_attribute", "pipeline_attribute"],
      "properties": {
        "format": {"const": "html"},
        "pages": {"type": "array", "items": {"enum": ["outline", "chapter", "position", "structure", "cover", "visualizations"]}},
        "binding_attribute": {"const": "data-variable-slot"},
        "pipeline_attribute": {"const": "data-pipeline-slot"}
      }
    },
    "visualization_plan": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["visualization_id", "title", "figure_kind", "renderer", "data_pointer", "source_pipeline_ids", "automatic", "release_state"],
        "properties": {
          "visualization_id": {"type": "string"},
          "title": {"type": "string"},
          "figure_kind": {"type": "string"},
          "renderer": {"const": "inline_svg"},
          "data_pointer": {"type": "string", "pattern": "^/"},
          "source_pipeline_ids": {"type": "array", "items": {"type": "string", "pattern": "^PIPE-"}},
          "source_path_refs": {"type": "array", "items": {"type": "string", "pattern": "^RW-"}},
          "automatic": {"const": true},
          "release_state": {"const": "preview_only"}
        }
      }
    }
  }
}

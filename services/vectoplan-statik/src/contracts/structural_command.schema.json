{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vectoplan.local/contracts/structural-command/0.1",
  "title": "VECTOPLAN structural command draft",
  "type": "object",
  "required": [
    "contract_version",
    "command",
    "project_ref",
    "element_ref",
    "base_revision_ref",
    "client_command_id",
    "parameters"
  ],
  "properties": {
    "contract_version": {"const": "structural-command/0.1"},
    "command": {
      "enum": ["update_element_parameters", "set_review_status", "add_load_case"]
    },
    "project_ref": {"type": "string", "minLength": 1},
    "element_ref": {"type": "string", "minLength": 1},
    "base_revision_ref": {"type": "string", "minLength": 1},
    "client_command_id": {"type": "string", "minLength": 1},
    "parameters": {"type": "object", "minProperties": 1}
  },
  "additionalProperties": true
}

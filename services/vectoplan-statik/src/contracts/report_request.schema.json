{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vectoplan.local/contracts/structural-report-request/0.1",
  "title": "VECTOPLAN structural report request",
  "type": "object",
  "required": ["contract_version", "project_ref", "source_revision_ref", "format", "sections"],
  "properties": {
    "contract_version": {"const": "structural-report-request/0.1"},
    "project_ref": {"type": "string", "minLength": 1},
    "source_revision_ref": {"type": "string", "minLength": 1},
    "format": {"const": "pdf"},
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {"enum": ["model", "assumptions", "loads", "checks", "results", "comments"]},
      "uniqueItems": true
    }
  },
  "additionalProperties": true
}

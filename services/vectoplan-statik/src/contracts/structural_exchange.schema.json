{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vectoplan.local/contracts/vectoplan-structural-exchange/0.2",
  "title": "VECTOPLAN neutral structural exchange",
  "type": "object",
  "required": ["contract_version", "exchange_ref", "coordinate_system", "source", "analysis_job", "adapter_targets"],
  "properties": {
    "contract_version": {"const": "vectoplan-structural-exchange/0.2"},
    "exchange_ref": {"type": "string", "minLength": 1},
    "coordinate_system": {
      "type": "object",
      "required": ["handedness", "vertical_axis", "length_unit", "force_unit"],
      "properties": {
        "handedness": {"const": "right"},
        "vertical_axis": {"enum": ["X", "Y", "Z"]},
        "length_unit": {"type": "string"},
        "force_unit": {"type": "string"}
      }
    },
    "source": {"type": "object"},
    "standards_profile": {"type": ["string", "null"]},
    "analysis_job": {"type": "object"},
    "analysis_result": {"type": ["object", "null"]},
    "adapter_targets": {"type": "object"}
  },
  "additionalProperties": false
}

      "selection": {"all": []},
      "steps": [
        {"step_id": "01", "label": "Horizontales Gleichgewicht", "formula_ref": "EQ-001", "runtime_step_ids": ["grillage_equilibrium"], "input_bindings": ["Einwirkungen F_x", "Reaktionen R_x"], "output": "Restkraft in x"},
        {"step_id": "02", "label": "Vertikales Gleichgewicht", "formula_ref": "EQ-002", "runtime_step_ids": ["grillage_equilibrium"], "input_bindings": ["Einwirkungen F_z", "Reaktionen R_z"], "output": "Restkraft in z"},
        {"step_id": "03", "label": "Momentengleichgewicht", "formula_ref": "EQ-003", "runtime_step_ids": [], "input_bindings": ["Kräfte", "Hebelarme", "Bezugspunkt"], "output": "Restmoment"}
      ],
      "supporting_formula_refs": ["EQ-004", "MECH-001", "VEC-001", "VEC-002", "MOM-001", "ACTION-001", "SUPPORT-001", "CUT-001"],

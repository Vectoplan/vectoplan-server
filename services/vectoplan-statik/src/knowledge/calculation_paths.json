{
  "schema_version": "structural-calculation-path-catalog/0.1",
  "title": "VECTOPLAN Rechenweg-Katalog",
  "purpose": "Dauerhafte, datengetriebene Auswahl- und Ablaufregeln zwischen Formelkatalog und Rechenpipeline.",
  "policy": {
    "formula_source": "Jeder Rechenweg trennt normative Eurocode-Regel-IDs von den referenzierten internen Rechenmethoden. Ausführung erfordert eine fachlich bestätigte Normzuordnung.",
    "selection": "Rechenwege werden aus Projektfakten und deklarativen Regeln ausgewählt; die Python-Pipeline enthält keine fachlichen Formelkopien.",
    "old_new_methods": "Aktuelle, historische und zukünftige Normgenerationen bleiben getrennte Methodenvarianten. Historische Varianten werden niemals automatisch für aktuelle Projekte aktiviert.",
    "unknowns": "Nicht verifizierte oder nicht implementierte Ansätze bleiben sichtbar und werden als unvollständig beziehungsweise gesperrt ausgewiesen.",
    "approval": "Ein ausgewählter und ausgeführter Rechenweg ist kein prüffähiger Nachweis ohne fachliche und normative Freigabe."
  },
  "categories": [
    {"category_id": "01_basis", "order": 1, "label": "Grundlagen & Modellbildung"},
    {"category_id": "02_actions", "order": 2, "label": "Einwirkungen"},
    {"category_id": "03_safety", "order": 3, "label": "Sicherheit & Kombination"},
    {"category_id": "04_analysis", "order": 4, "label": "Tragwerksanalyse"},
    {"category_id": "05_sections", "order": 5, "label": "Querschnitt & Verformung"},
    {"category_id": "06_materials", "order": 6, "label": "Materialbemessung"},
    {"category_id": "07_geotechnics", "order": 7, "label": "Baugrund & Gründung"},
    {"category_id": "08_special", "order": 8, "label": "Stabilität & Sondernachweise"},
    {"category_id": "09_systems", "order": 9, "label": "Tragwerksformen & Ausbau"}
  ],
  "rule_operators": ["equals", "not_equals", "contains", "contains_any", "exists", "greater_than", "at_least"],
  "paths": [
    {

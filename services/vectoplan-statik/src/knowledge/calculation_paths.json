      "selection": {"any": [{"fact": "load_case_action_types", "operator": "contains", "value": "snow"}, {"fact": "environmental_action_types", "operator": "contains", "value": "snow"}]},
      "steps": [
        {"step_id": "01", "label": "Dachschneelast", "formula_ref": "SNOW-001", "runtime_step_ids": ["roof_snow"], "input_bindings": ["μ_i", "C_e", "C_t", "s_k"], "output": "s in kN/m²"},
        {"step_id": "02", "label": "Lasteinzugsfläche", "formula_ref": "SNOW-002", "runtime_step_ids": ["snow_to_node"], "input_bindings": ["s", "A_t"], "output": "F_s in kN"}
      ],
      "supporting_formula_refs": [],
      "alternatives": [{"method_id": "din1055-5-historical", "label": "DIN 1055-5:2005 – historisch", "status": "historical_reference", "formula_refs": ["SNOW-HIST-001", "SNOW-HIST-002", "SNOW-HIST-003", "SNOW-HIST-004", "SNOW-GROUND-HIST-001"], "activation": "nur explizites historisches Vergleichsprojekt", "note": "Nicht als aktueller automatischer Bemessungspfad zulässig."}],
      "outputs": ["Dachschneelast", "abgeleitete Knotenlast"]
    },

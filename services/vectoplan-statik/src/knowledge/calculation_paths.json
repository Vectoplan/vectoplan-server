      "steps": [
        {"step_id": "01", "label": "Bauteilgewicht", "formula_ref": "LOAD-001", "runtime_step_ids": ["self_weight"], "input_bindings": ["Volumen", "bestätigte Materialwichte"], "output": "charakteristische Gewichtskraft"},
        {"step_id": "02", "label": "Schichtenaufbau", "formula_ref": "LOAD-002", "runtime_step_ids": ["layered_area_load"], "input_bindings": ["Schichtdicken", "Schichtwichten"], "output": "ständige Flächenlast"},
        {"step_id": "03", "label": "Lasteinzugsbreite", "formula_ref": "LOAD-003", "runtime_step_ids": ["area_to_line"], "input_bindings": ["Flächenlast", "Lasteinzugsbreite"], "output": "Streckenlast"},
        {"step_id": "04", "label": "Resultierende", "formula_ref": "LOAD-004", "runtime_step_ids": [], "input_bindings": ["Streckenlast", "Länge"], "output": "Einzellast"}
      ],
      "supporting_formula_refs": [],
      "alternatives": [{"method_id": "historical-density-reference", "label": "Historische Wichtetabellen", "status": "historical_reference", "formula_refs": ["DENS-HIST-001", "DENS-HIST-002"], "activation": "nie automatisch", "note": "Nur Quellenvergleich; Rechenwerte stammen aus versionierten Materialprofilen."}],
      "outputs": ["Lastfälle mit Herkunft", "Lasteinzugszuordnung"]
    },
    {

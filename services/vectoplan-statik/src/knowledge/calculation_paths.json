        {"step_id": "02", "label": "Spitzengeschwindigkeitsdruck", "formula_ref": "WIND-002", "runtime_step_ids": ["peak_velocity_pressure"], "input_bindings": ["c_e(z)", "q_b"], "output": "q_p(z)"},
        {"step_id": "03", "label": "Netto-Winddruck", "formula_ref": "WIND-003", "runtime_step_ids": ["net_wind_pressure"], "input_bindings": ["q_p", "c_pe", "c_pi"], "output": "w"},
        {"step_id": "04", "label": "Windresultierende", "formula_ref": "WIND-004", "runtime_step_ids": ["wind_resultant"], "input_bindings": ["w", "A"], "output": "F_w"}
      ],
      "supporting_formula_refs": [],
      "alternatives": [
        {"method_id": "din1055-4-historical", "label": "DIN 1055-4:2005 mit Berichtigung – historisch", "status": "historical_reference", "formula_refs": ["WIND-HIST-001", "WIND-HIST-002", "WIND-HIST-003", "WIND-CORR-001"], "activation": "nur explizites historisches Vergleichsprojekt", "note": "Berichtigung ist bei einem historischen Vergleich zwingend als Overlay zu behandeln."},
        {"method_id": "dynamic-wind", "label": "Windinduzierte Schwingungen", "status": "incomplete", "formula_refs": ["WIND-DYN-001"], "activation": "bei dynamischer Empfindlichkeit", "note": "Dynamischer Solver und normative Verifikation fehlen."}
      ],
      "outputs": ["Netto-Flächendruck", "Windresultierende"]
    },

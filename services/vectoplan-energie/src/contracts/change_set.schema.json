{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.vectoplan.local/energie/change_set.schema.json",
  "title": "VECTOPLAN Energy Change Set",
  "type": "object",
  "required": ["project_id", "base_revision", "changes"],
  "properties": {
    "project_id": {"type": "string", "minLength": 1},
    "base_revision": {"type": "string", "minLength": 1},
    "intent": {"type": "string"},
    "changes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "operation", "value"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "operation": {"enum": ["set", "replace", "remove"]},
          "value": {}
        }
      }
    }
  },
  "additionalProperties": true
}

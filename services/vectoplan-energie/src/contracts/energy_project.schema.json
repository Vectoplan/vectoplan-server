{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.vectoplan.local/energie/energy_project.schema.json",
  "title": "VECTOPLAN Energy Project Snapshot",
  "type": "object",
  "required": ["schema_version", "revision", "project", "building", "geometry", "envelope", "systems", "provenance"],
  "properties": {
    "schema_version": {"const": "energy-project/0.1"},
    "revision": {"type": "string", "minLength": 1},
    "project": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1}
      }
    },
    "building": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {"enum": ["residential", "non_residential"]}
      }
    },
    "geometry": {"type": "object"},
    "envelope": {"type": "object"},
    "systems": {"type": "object"},
    "provenance": {"type": "object"}
  },
  "additionalProperties": true
}

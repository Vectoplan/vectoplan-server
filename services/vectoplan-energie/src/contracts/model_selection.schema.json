{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vectoplan.local/contracts/energy/model-selection.v1.json",
  "title": "VECTOPLAN energy model selection",
  "type": "object",
  "required": ["contract", "type", "source", "selection"],
  "properties": {
    "contract": {"const": "vectoplan.energy-selection.v1"},
    "type": {"enum": ["vectoplan.energy-selection.ready", "vectoplan.energy-selection.request", "vectoplan.energy-selection.changed"]},
    "source": {"enum": ["vectoplan-editor", "vectoplan-cad", "vectoplan-energie"]},
    "projectId": {"type": "string", "maxLength": 240},
    "revision": {"type": "string", "maxLength": 240},
    "selection": {
      "type": "object",
      "required": ["objects"],
      "properties": {
        "objects": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "type": "object",
            "required": ["id", "kind"],
            "properties": {
              "id": {"type": "string", "maxLength": 240},
              "kind": {"type": "string", "maxLength": 120},
              "name": {"type": "string", "maxLength": 240},
              "properties": {"type": "object", "maxProperties": 128},
              "geometryRef": {"type": "string", "maxLength": 400},
              "libraryRef": {"type": "string", "maxLength": 400}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}

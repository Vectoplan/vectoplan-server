{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vectoplan.local/contracts/cad-roof-calculation-request-0.1.schema.json",
  "title": "VECTOPLAN parametric roof request",
  "type": "object",
  "required": ["contract_version", "roof_type", "footprint", "parameters"],
  "properties": {
    "contract_version": {"const": "cad-roof-calculation-request/0.1"},
    "roof_type": {"enum": ["flat", "gable", "hipped", "half_hipped", "pent", "mansard", "trapezoid", "butterfly", "pyramid", "barrel", "sawtooth"]},
    "footprint": {
      "type": "object",
      "required": ["outer_ring_mm"],
      "properties": {"outer_ring_mm": {"type": "array", "minItems": 3, "items": {"$ref": "#/$defs/point"}}}
    },
    "parameters": {
      "type": "object",
      "properties": {
        "pitch_deg": {"type": "number", "minimum": 0, "maximum": 80},
        "eaves_height_mm": {"type": "number"},
        "ridge_direction": {"oneOf": [{"enum": ["auto", "x", "y"]}, {"type": "number"}]},
        "overhang_mm": {
          "oneOf": [
            {"type": "number", "minimum": 0},
            {
              "type": "object",
              "properties": {
                "default_mm": {"type": "number", "minimum": 0},
                "north_mm": {"type": "number", "minimum": 0},
                "east_mm": {"type": "number", "minimum": 0},
                "south_mm": {"type": "number", "minimum": 0},
                "west_mm": {"type": "number", "minimum": 0},
                "edges_mm": {"type": "array", "items": {"type": "number", "minimum": 0}}
              }
            }
          ]
        },
        "roof_skin_thickness_mm": {"type": "number", "exclusiveMinimum": 0},
        "roof_skin_material": {"type": "string"},
        "plateau_width_ratio": {"type": "number", "minimum": 0.05, "maximum": 0.8},
        "mansard_break_ratio": {"type": "number", "minimum": 0.1, "maximum": 0.8},
        "mansard_lower_pitch_deg": {"type": "number", "minimum": 10, "maximum": 85},
        "mansard_upper_pitch_deg": {"type": "number", "minimum": 1, "maximum": 70},
        "hip_end_ratio": {"type": "number", "minimum": 0.1, "maximum": 1},
        "barrel_rise_mm": {"type": "number", "exclusiveMinimum": 0},
        "barrel_segment_count": {"type": "integer", "minimum": 4, "maximum": 64},
        "sawtooth_count": {"type": "integer", "minimum": 1, "maximum": 20},
        "sawtooth_pitch_deg": {"type": "number", "minimum": 5, "maximum": 80},
        "structure": {
          "type": "object",
          "properties": {
            "rafter": {"$ref": "#/$defs/memberConfiguration"},
            "purlin": {"$ref": "#/$defs/memberConfiguration"}
          }
        }
      }
    }
  },
  "$defs": {
    "point": {"type": "array", "prefixItems": [{"type": "number"}, {"type": "number"}], "items": false},
    "memberConfiguration": {
      "type": "object",
      "properties": {
        "width_mm": {"type": "number", "exclusiveMinimum": 0},
        "height_mm": {"type": "number", "exclusiveMinimum": 0},
        "spacing_mm": {"type": "number", "exclusiveMinimum": 0},
        "maximum_spacing_mm": {"type": "number", "exclusiveMinimum": 0}
      }
    }
  }
}

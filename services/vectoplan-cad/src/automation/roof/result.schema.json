{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vectoplan.local/contracts/cad-roof-calculation-result-0.1.schema.json",
  "title": "VECTOPLAN parametric roof result",
  "type": "object",
  "required": ["ok", "contract_version", "calculation_id", "roof_type", "geometry", "roof_skin", "structure", "summary", "recalculation", "export"],
  "properties": {
    "ok": {"const": true},
    "contract_version": {"const": "cad-roof-calculation-result/0.1"},
    "calculation_id": {"type": "string"},
    "roof_type": {"type": "string"},
    "geometry": {
      "type": "object",
      "required": ["roof_coverage_polygon_mm", "edge_overhangs_mm", "ridge_direction_deg", "faces"],
      "properties": {
        "roof_coverage_polygon_mm": {"type": "array"},
        "edge_overhangs_mm": {"type": "array", "items": {"type": "number", "minimum": 0}},
        "ridge_direction_deg": {"type": "number"},
        "faces": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/face"}}
      }
    },
    "roof_skin": {"type": "object"},
    "structure": {
      "type": "object",
      "required": ["rafters", "purlins", "summary"],
      "properties": {
        "rafters": {"type": "array", "items": {"$ref": "#/$defs/member"}},
        "purlins": {"type": "array", "items": {"$ref": "#/$defs/member"}}
      }
    },
    "summary": {"type": "object"},
    "recalculation": {"type": "object"},
    "export": {"type": "object"}
  },
  "$defs": {
    "face": {
      "type": "object",
      "required": ["face_ref", "role", "pitch_deg", "polygon_3d_mm", "surface_area_m2"],
      "properties": {"polygon_3d_mm": {"type": "array", "minItems": 3}}
    },
    "member": {
      "type": "object",
      "required": ["member_ref", "role", "start_3d_mm", "end_3d_mm", "length_mm", "section_mm", "timber_volume_m3"]
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vectoplan.local/contracts/cad_projection_input.schema.json",
  "title": "CadProjectionInput",
  "type": "object",
  "required": ["contract_version", "document", "sheets"],
  "properties": {
    "contract_version": {"type": "string", "minLength": 1},
    "allowed_commands": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "document": {
      "type": "object",
      "required": ["document_ref", "project_ref", "source_revision_ref", "plan_profile"],
      "properties": {
        "document_ref": {"type": "string", "minLength": 1},
        "project_ref": {"type": "string", "minLength": 1},
        "source_revision_ref": {"type": "string", "minLength": 1},
        "library_revision_ref": {"type": ["string", "null"]},
        "plan_profile": {"type": "object"}
      },
      "additionalProperties": true
    },
    "sheets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["sheet_ref", "format", "width_mm", "height_mm", "viewports", "elements"],
        "properties": {
          "sheet_ref": {"type": "string", "minLength": 1},
          "format": {"type": "string", "minLength": 1},
          "width_mm": {"type": "number", "exclusiveMinimum": 0},
          "height_mm": {"type": "number", "exclusiveMinimum": 0},
          "viewports": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["viewport_ref", "kind", "sheet_rect_mm"],
              "properties": {
                "viewport_ref": {"type": "string", "minLength": 1},
                "kind": {"type": "string", "minLength": 1},
                "sheet_rect_mm": {"$ref": "#/$defs/rect"},
                "model_view_box_mm": {"$ref": "#/$defs/rect"}
              },
              "additionalProperties": true
            }
          },
          "elements": {
            "type": "array",
            "items": {"$ref": "#/$defs/element"}
          }
        },
        "additionalProperties": true
      }
    }
  },
  "$defs": {
    "point": {
      "type": "array",
      "prefixItems": [{"type": "number"}, {"type": "number"}],
      "minItems": 2,
      "maxItems": 2
    },
    "rect": {
      "type": "object",
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": {"type": "number"},
        "y": {"type": "number"},
        "width": {"type": "number", "exclusiveMinimum": 0},
        "height": {"type": "number", "exclusiveMinimum": 0}
      },
      "additionalProperties": false
    },
    "element": {
      "type": "object",
      "required": ["element_ref", "kind", "layer", "view_refs", "geometry"],
      "properties": {
        "element_ref": {"type": "string", "minLength": 1},
        "kind": {
          "enum": ["wall", "opening", "structure", "line", "text", "room_label", "dimension"]
        },
        "layer": {"type": "string", "minLength": 1},
        "view_refs": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "geometry": {"type": "object"}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
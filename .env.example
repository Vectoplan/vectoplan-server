VECTOPLAN_ENERGIE_CAD_ROUTE=/cad

# ------------------------------------------------------------------------------
# Core Service (CAD <-> Chunk translation)
# ------------------------------------------------------------------------------
VECTOPLAN_CORE_CONFIG=production
VECTOPLAN_CORE_POSTGRES_DB=vectoplan_core
VECTOPLAN_CORE_POSTGRES_USER=vectoplan_core
VECTOPLAN_CORE_POSTGRES_PASSWORD=vectoplan_core
VECTOPLAN_CORE_DATABASE_URL=postgresql+psycopg://vectoplan_core:vectoplan_core@vectoplan-core-db:5432/vectoplan_core
VECTOPLAN_CORE_AUTO_CREATE_SCHEMA=false
VECTOPLAN_CORE_STORAGE_ROOT=/var/lib/vectoplan-core/storage
VECTOPLAN_CORE_CHUNK_INTERNAL_URL=http://vectoplan-chunk:5000
VECTOPLAN_CORE_CHUNK_SERVICE_ID=vectoplan-core
VECTOPLAN_CORE_INTERNAL_API_KEY=dev-vectoplan-core-service-key-change-me
VECTOPLAN_CORE_REQUIRE_INTERNAL_AUTH=true
VECTOPLAN_CORE_DEFAULT_CELL_SIZE_MM=1000
VECTOPLAN_APP_CORE_PROVISION_ON_PROJECT_CREATE=true
VECTOPLAN_APP_CORE_PROVISIONING_REQUIRED=true
VECTOPLAN_APP_CORE_TIMEOUT_SECONDS=10
VECTOPLAN_CAD_PUBLIC_URL=http://localhost:5104
VECTOPLAN_CAD_INTERNAL_URL=http://vectoplan-cad:5000
VECTOPLAN_CAD_ROUTE=/cad
VECTOPLAN_CAD_EMBED_ENABLED=true
VECTOPLAN_APP_ALLOWED_FRAME_SRC=self http://localhost:5100 http://127.0.0.1:5100 http://localhost:5104 http://127.0.0.1:5104 http://localhost:5190 http://127.0.0.1:5190

VECTOPLAN_APP_DB_HOST=vectoplan-app-db
VECTOPLAN_APP_DB_PORT=5432
VECTOPLAN_APP_DB_NAME=vectoplan_app
VECTOPLAN_APP_DB_USER=vectoplan_app
VECTOPLAN_APP_DB_PASSWORD=vectoplan_app

VECTOPLAN_APP_DATABASE_URL=postgresql+psycopg://vectoplan_app:vectoplan_app@vectoplan-app-db:5432/vectoplan_app

VECTOPLAN_APP_GUNICORN_WORKERS=2
VECTOPLAN_APP_GUNICORN_THREADS=4

VECTOPLAN_APP_HEALTH_INTERVAL=20s
VECTOPLAN_APP_HEALTH_TIMEOUT=5s
VECTOPLAN_APP_HEALTH_RETRIES=10
VECTOPLAN_APP_HEALTH_START_PERIOD=30s
VECTOPLAN_APP_MAPBOX_GEOCODING_ENABLED=true
VECTOPLAN_APP_MAPBOX_GEOCODING_ENDPOINT=https://api.mapbox.com/search/geocode/v6/forward
VECTOPLAN_APP_MAPBOX_LANGUAGE=de
VECTOPLAN_APP_MAPBOX_COUNTRIES=de
VECTOPLAN_APP_MAPBOX_TIMEOUT_SECONDS=4
VECTOPLAN_APP_MAPBOX_PERMANENT_GEOCODING=true
# Transparenter Standardstandort, wenn Mapbox fehlt oder vorübergehend ausfällt.
VECTOPLAN_APP_GEOCODING_FALLBACK_ENABLED=true
VECTOPLAN_APP_GEOCODING_FALLBACK_LONGITUDE=13.405
VECTOPLAN_APP_GEOCODING_FALLBACK_LATITUDE=52.52
VECTOPLAN_APP_GEOCODING_FALLBACK_LABEL=Berlin, Deutschland (Standardstandort)
VECTOPLAN_APP_GEOREFERENCE_GEOCODER_ENABLED=true
VECTOPLAN_APP_GEOREFERENCE_DISCOVER_GEOCODER=true
VECTOPLAN_APP_PERSIST_DERIVED_GEOREFERENCE=true



# ------------------------------------------------------------------------------
# OpenLayer
# ------------------------------------------------------------------------------

OPENLAYER_LOG_LEVEL=INFO
OPENLAYER_HEALTH_INTERVAL=10s
OPENLAYER_HEALTH_TIMEOUT=5s
OPENLAYER_HEALTH_RETRIES=5
OPENLAYER_HEALTH_START_PERIOD=15s

# Canonical Mapbox credential used by vectoplan-app geocoding and OpenLayer.
# Create/rotate it in Mapbox and set only this variable where possible.
MAPBOX_ACCESS_TOKEN=
# Backward-compatible aliases. Compose normalizes either alias to the same
# value for both services; do not configure competing values.
VECTOPLAN_MAPBOX_TOKEN=
MAPBOX_TOKEN=
MAPBOX_STYLE_URL=
MAPBOX_DEFAULT_STYLE=mapbox/satellite-streets-v12



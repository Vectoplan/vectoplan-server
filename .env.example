VECTOPLAN_EDITOR_HEALTH_INTERVAL=30s
VECTOPLAN_EDITOR_HEALTH_TIMEOUT=5s
VECTOPLAN_EDITOR_HEALTH_RETRIES=5
VECTOPLAN_EDITOR_HEALTH_START_PERIOD=30s



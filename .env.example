VECTOPLAN_EDITOR_INVENTORY_ALLOW_PLACE_ACTION=true
VECTOPLAN_EDITOR_INVENTORY_ALLOW_BREAK_ACTION=true

VECTOPLAN_EDITOR_CHUNKS_ENABLED=true
VECTOPLAN_EDITOR_CHUNKS_EMPTY_WORLD=false
VECTOPLAN_EDITOR_CHUNKS_CHUNK_SIZE=16
VECTOPLAN_EDITOR_CHUNKS_VIEW_DISTANCE=7
VECTOPLAN_EDITOR_CHUNKS_PRELOAD_RADIUS=1
VECTOPLAN_EDITOR_CHUNKS_UNLOAD_DISTANCE=9
VECTOPLAN_EDITOR_CHUNKS_MAX_LOADED_CHUNKS=384
VECTOPLAN_EDITOR_CHUNKS_LOAD_AROUND_PLAYER=true
VECTOPLAN_EDITOR_CHUNKS_DEBUG_DRAW_CHUNK_BOUNDS=true
VECTOPLAN_EDITOR_CHUNKS_PREFER_BATCH_LOAD=true
VECTOPLAN_EDITOR_CHUNKS_RELOAD_DIRTY_AFTER_COMMAND=true

VECTOPLAN_EDITOR_GUNICORN_APP=wsgi:app
VECTOPLAN_EDITOR_GUNICORN_WORKERS=2
VECTOPLAN_EDITOR_GUNICORN_THREADS=2
VECTOPLAN_EDITOR_GUNICORN_TIMEOUT=120
VECTOPLAN_EDITOR_GUNICORN_KEEPALIVE=5
VECTOPLAN_EDITOR_GUNICORN_LOG_LEVEL=info
VECTOPLAN_EDITOR_GUNICORN_ACCESSLOG=-

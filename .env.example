VECTOPLAN_EDITOR_CHUNK_STATUS_TIMEOUT=5
VECTOPLAN_EDITOR_CHUNK_MAX_RESPONSE_BYTES=20971520
VECTOPLAN_EDITOR_CHUNK_STATUS_PATHS=/projects/_status,/chunks/_status,/commands/_status,/

VECTOPLAN_EDITOR_CHUNK_PROXY_DIAGNOSTICS_ENABLED=true
VECTOPLAN_EDITOR_CHUNK_PROXY_ALLOW_PROJECT_MUTATIONS=true
VECTOPLAN_EDITOR_CHUNK_PROXY_ALLOW_WORLD_MUTATIONS=true

# Productive Inventory:
#   /editor/api/inventory
# Chunk inventory remains diagnostic/legacy only.
VECTOPLAN_EDITOR_INVENTORY_SOURCE=editor-inventory
VECTOPLAN_EDITOR_INVENTORY_ICON_MODE=icon-only

# Rein visuelle Earth-Geodaten-Layer. Standardmaessig wird der freigegebene
# Orchestrator-Datensatz "flurstuecke" als Oberflaechenlinie eingeblendet.
# Ein JSON-Array in VECTOPLAN_CHUNK_GEODATA_OVERLAYS_JSON ersetzt diese Defaults;
# konkrete WorldInstances koennen sie ueber metadata.geodataOverlays ueberschreiben.
VECTOPLAN_CHUNK_GEODATA_OVERLAYS_ENABLED=true
VECTOPLAN_CHUNK_GEODATA_OVERLAYS_JSON=
VECTOPLAN_CHUNK_GEODATA_OVERLAY_TIMEOUT_SECONDS=20
VECTOPLAN_CHUNK_GEODATA_OVERLAY_VERSION_CACHE_SECONDS=60
VECTOPLAN_CHUNK_GEODATA_OVERLAY_TILE_CACHE_SECONDS=30

VECTOPLAN_CHUNK_SQLALCHEMY_TRACK_MODIFICATIONS=false
VECTOPLAN_CHUNK_SQLALCHEMY_ECHO=false
VECTOPLAN_CHUNK_SQLALCHEMY_RECORD_QUERIES=false

VECTOPLAN_CHUNK_DB_POOL_PRE_PING=true
VECTOPLAN_CHUNK_SQLALCHEMY_POOL_PRE_PING=true
VECTOPLAN_CHUNK_DB_POOL_RECYCLE=1800
VECTOPLAN_CHUNK_SQLALCHEMY_POOL_RECYCLE=1800
VECTOPLAN_CHUNK_DB_POOL_SIZE=5
VECTOPLAN_CHUNK_SQLALCHEMY_POOL_SIZE=5
VECTOPLAN_CHUNK_DB_MAX_OVERFLOW=10
VECTOPLAN_CHUNK_SQLALCHEMY_MAX_OVERFLOW=10
VECTOPLAN_CHUNK_DB_POOL_TIMEOUT=30
VECTOPLAN_CHUNK_SQLALCHEMY_POOL_TIMEOUT=30
VECTOPLAN_CHUNK_DB_CONNECT_TIMEOUT=15

VECTOPLAN_CHUNK_DB_WAIT_FOR_READY=true
VECTOPLAN_CHUNK_DB_WAIT_TIMEOUT=60
VECTOPLAN_CHUNK_DB_WAIT_INTERVAL=2
VECTOPLAN_CHUNK_DB_REQUIRE_READY=true


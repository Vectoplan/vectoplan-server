{
  "name": "vectoplan-editor",
  "version": "0.1.0",
  "private": true,
  "description": "Frontend build and runtime source setup for the VECTOPLAN editor.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=20.19.0 <21 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite --config src/frontend/vite.config.ts --host 0.0.0.0 --port 5173",
    "build": "vite build --config src/frontend/vite.config.ts",
    "build:watch": "vite build --watch --config src/frontend/vite.config.ts",
    "preview": "vite preview --config src/frontend/vite.config.ts --host 0.0.0.0 --port 4173",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test:lod2-buildings": "esbuild tests/lod2.test.ts --bundle --platform=node --format=esm --outfile=.tmp-tests/lod2.test.mjs && node --test .tmp-tests/lod2.test.mjs",
    "test:chunk-map": "esbuild tests/chunk_map_geometry.test.ts --bundle --platform=node --format=cjs --outfile=.tmp-tests/chunk-map-geometry.test.cjs && node --test .tmp-tests/chunk-map-geometry.test.cjs",
    "test:terrain-surface": "esbuild tests/terrain_surface.test.ts --bundle --platform=node --format=cjs --outfile=.tmp-tests/terrain-surface.test.cjs && node .tmp-tests/terrain-surface.test.cjs",
    "test:chunk-command-result": "esbuild tests/chunk_command_result.test.ts --bundle --platform=node --format=cjs --outfile=.tmp-tests/chunk-command-result.test.cjs && node --test .tmp-tests/chunk-command-result.test.cjs",
    "test:chunk-service-source-dirty": "esbuild tests/chunk_service_source_dirty.test.ts --bundle --platform=node --format=cjs --outfile=.tmp-tests/chunk-service-source-dirty.test.cjs && node --test .tmp-tests/chunk-service-source-dirty.test.cjs",
    "test:semantic-object-refs": "esbuild tests/semantic_object_refs.test.ts --bundle --platform=node --format=cjs --outfile=.tmp-tests/semantic-object-refs.test.cjs && node --test .tmp-tests/semantic-object-refs.test.cjs",
    "test:hotbar-reload-policy": "esbuild tests/hotbar_reload_policy.test.ts --bundle --platform=node --format=cjs --outfile=.tmp-tests/hotbar-reload-policy.test.cjs && node --test .tmp-tests/hotbar-reload-policy.test.cjs",
    "test:parcel-grid": "esbuild tests/parcel_grid_geometry.test.ts --bundle --platform=node --format=cjs --outfile=.tmp-tests/parcel-grid-geometry.test.cjs && node --test .tmp-tests/parcel-grid-geometry.test.cjs",
    "test:berlin-parcel-grid": "esbuild tests/berlin_parcel_grid_audit.test.ts --bundle --platform=node --format=cjs --outfile=.tmp-tests/berlin-parcel-grid-audit.test.cjs && node --test .tmp-tests/berlin-parcel-grid-audit.test.cjs",
    "audit:berlin-geometry": "esbuild scripts/generate_berlin_geometry_audit.ts --bundle --platform=node --format=esm --outfile=.tmp-tests/berlin-geometry-audit.mjs && node .tmp-tests/berlin-geometry-audit.mjs",
    "test:parcel-selection": "esbuild tests/parcel_selection_normalization.test.ts --bundle --platform=node --format=cjs --outfile=.tmp-tests/parcel-selection-normalization.test.cjs && node --test .tmp-tests/parcel-selection-normalization.test.cjs",
    "test:world-edit-systems": "esbuild tests/world_edit_system_registry.test.ts --bundle --platform=node --format=cjs --outfile=.tmp-tests/world-edit-system-registry.test.cjs && node --test .tmp-tests/world-edit-system-registry.test.cjs",
    "test:storey-system": "esbuild tests/storey_system.test.ts --bundle --platform=node --format=cjs --outfile=.tmp-tests/storey-system.test.cjs && node --test .tmp-tests/storey-system.test.cjs",
    "test:storey-drag": "esbuild tests/storey_drag.test.ts --bundle --platform=node --format=cjs --outfile=.tmp-tests/storey-drag.test.cjs && node .tmp-tests/storey-drag.test.cjs",
    "test:building-ownership": "esbuild tests/line_brush_storey_ownership.test.ts --bundle --platform=node --format=cjs --outfile=.tmp-tests/building-ownership.test.cjs && node .tmp-tests/building-ownership.test.cjs",
    "test:roof-walls": "esbuild tests/line_brush_roof_walls.test.ts --bundle --platform=node --format=cjs --outfile=.tmp-tests/roof-walls.test.cjs && node .tmp-tests/roof-walls.test.cjs",
    "test:workspace-modes": "esbuild tests/editor_workspace_modes.test.ts --bundle --platform=node --format=cjs --outfile=.tmp-tests/editor-workspace-modes.test.cjs && node --test .tmp-tests/editor-workspace-modes.test.cjs",
    "test:planning-massing": "esbuild tests/planning_massing.test.ts --bundle --platform=node --format=cjs --outfile=.tmp-tests/planning-massing.test.cjs && node --test .tmp-tests/planning-massing.test.cjs",
    "test:building-programs": "esbuild tests/line_brush_building_programs.test.ts --bundle --platform=node --format=cjs --outfile=.tmp-tests/line-brush-building-programs.test.cjs && node --test .tmp-tests/line-brush-building-programs.test.cjs",
    "test:building-quick-settings": "esbuild tests/line_brush_quick_settings_state.test.ts --bundle --platform=node --format=cjs --outfile=.tmp-tests/line-brush-quick-settings-state.test.cjs && node --test .tmp-tests/line-brush-quick-settings-state.test.cjs",
    "test:building-geometry": "esbuild tests/line_brush_building_geometry.test.ts --bundle --platform=node --format=cjs --outfile=.tmp-tests/line-brush-building-geometry.test.cjs && node --test .tmp-tests/line-brush-building-geometry.test.cjs",
    "test:geodata-overlays": "esbuild tests/geodata_overlay_scene.test.ts --bundle --platform=node --format=cjs --outfile=.tmp-tests/geodata-overlay-scene.test.cjs && node --test .tmp-tests/geodata-overlay-scene.test.cjs",
    "test:navigation-compass-style": "esbuild tests/navigation_compass_style.test.ts --bundle --platform=node --format=esm --outfile=.tmp-tests/navigation-compass-style.test.mjs && node --test .tmp-tests/navigation-compass-style.test.mjs",
    "test:reconstruction-preview": "esbuild tests/reconstruction_preview_protocol.test.ts --bundle --platform=node --format=esm --outfile=.tmp-tests/reconstruction-preview-protocol.test.mjs && node --test .tmp-tests/reconstruction-preview-protocol.test.mjs",
    "check": "npm run test:lod2-buildings && npm run test:chunk-map && npm run test:parcel-grid && npm run test:berlin-parcel-grid && npm run test:parcel-selection && npm run test:world-edit-systems && npm run test:storey-system && npm run test:storey-drag && npm run test:building-ownership && npm run test:roof-walls && npm run test:terrain-surface && npm run test:workspace-modes && npm run test:planning-massing && npm run test:building-programs && npm run test:building-quick-settings && npm run test:building-geometry && npm run test:chunk-command-result && npm run test:chunk-service-source-dirty && npm run test:semantic-object-refs && npm run test:hotbar-reload-policy && npm run test:geodata-overlays && npm run test:navigation-compass-style && npm run test:reconstruction-preview && npm run test:chunk-streaming && npm run test:building-editing && npm run test:building-edit-visuals && npm run test:roof-continuations && npm run typecheck && npm run build",
    "test:roof-continuations": "esbuild tests/line_brush_roof_continuations.test.ts --bundle --platform=node --format=cjs --outfile=.tmp-tests/line_brush_roof_continuations.test.cjs && node .tmp-tests/line_brush_roof_continuations.test.cjs",
    "test:building-editing": "esbuild tests/line_brush_editing.test.ts --bundle --platform=node --format=cjs --outfile=.tmp-tests/line_brush_editing.test.cjs && node .tmp-tests/line_brush_editing.test.cjs",
    "test:chunk-streaming": "esbuild tests/chunk_streaming_policy.test.ts --bundle --platform=node --format=cjs --outfile=.tmp-tests/chunk_streaming_policy.test.cjs && node .tmp-tests/chunk_streaming_policy.test.cjs",
    "test:building-edit-visuals": "esbuild tests/line_brush_building_edit_visuals.test.ts --bundle --platform=node --format=cjs --outfile=.tmp-tests/line_brush_building_edit_visuals.test.cjs && node .tmp-tests/line_brush_building_edit_visuals.test.cjs"
  },
  "dependencies": {
    "three": "0.183.2"
  },
  "devDependencies": {
    "@types/node": "25.6.0",
    "esbuild": "0.28.0",
    "typescript": "6.0.2",
    "vite": "8.0.8"
  }
}
